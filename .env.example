# ---------------------------------------------------------------------------
# LibTrack environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed. Never put a real password or secret key in here.
# ---------------------------------------------------------------------------

# --- Django core ----------------------------------------------------------
# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Set to false on any real deployment. Never run with debug on in production.
DJANGO_DEBUG=false

# Comma separated. Only needed when the default hosts are not enough.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Turn on only when TLS terminates in front of the app (Vercel sets this header).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database (MySQL) -----------------------------------------------------
# When MYSQL_DATABASE is unset the project falls back to local SQLite so it
# can be demonstrated without a database server. MySQL is the target runtime.
MYSQL_DATABASE=libtrack
MYSQL_USER=libtrack_user
MYSQL_PASSWORD=replace-with-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

# --- Media ----------------------------------------------------------------
# Where uploaded cover images and digital materials are written.
# On a host with no persistent disk (Vercel), point this at object storage.
DJANGO_MEDIA_ROOT=

# --- Library business rules ----------------------------------------------
# All circulation limits are configurable; these are the defaults.
LIBRARY_LOAN_DAYS=14
LIBRARY_MAX_ACTIVE_LOANS=3
LIBRARY_MAX_RENEWALS=1
LIBRARY_RENEWAL_DAYS=7
LIBRARY_DUE_SOON_DAYS=7
LIBRARY_PAGE_SIZE=12

# --- Demo data ------------------------------------------------------------
# Local demonstration only. Never reuse this value in a shared environment.
LIBTRACK_DEMO_PASSWORD=replace-for-non-local-environments
